    <string name="explore_gallery_item_ajora_title">Ajora Falls</string>
    <string name="explore_gallery_item_ajora_desc">The only twin waterfall in Africa, where the Soke and Ajancho rivers cascade into a lush green valley.</string>
    <string name="explore_gallery_item_ajora_twin_title">Ajora Twin Waterfalls</string>
    <string name="explore_gallery_item_ajora_twin_desc">Two stunning waterfalls surrounded by a dense forest, located northwest of Sodo.</string>
    <string name="explore_gallery_item_bridge_title">The Bridge of God</string>
    <string name="explore_gallery_item_bridge_desc">A natural bridge carved by water over centuries, perfect for adventurous hikers.</string>
    <string name="explore_gallery_item_damot_title">Mount Damot</string>
    <string name="explore_gallery_item_damot_desc">One of the highest peaks in Wolayta, offering breathtaking views of the Rift Valley.</string>
    <string name="explore_gallery_item_culture_title">Wolayta Culture</string>
    <string name="explore_gallery_item_culture_desc">A rich tapestry of music, dance, crafts, and hospitality that defines the Wolayta people.</string>
