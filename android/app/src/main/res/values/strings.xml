    <string name="about_title">About Wolaita Tours</string>
    <string name="about_description">We are dedicated to showcasing the rich cultural heritage and natural beauty of Wolaita Zone, Ethiopia.</string>
    <string name="about_mission_title">Our Mission</string>
    <string name="about_mission_text">To provide authentic, sustainable, and memorable tourism experiences that connect visitors with the vibrant culture, traditions, and landscapes of Wolaita Zone while supporting local communities and preserving our heritage.</string>
