    <string name="explore_gallery_item_ajora_title">አጆራ ፏፏቴዎች</string>
    <string name="explore_gallery_item_ajora_desc">በአፍሪካ ብቸኛው መንትያ ፏፏቴ ሲሆን የሶኬ እና የአጃንቾ ወንዞች ወደ ለምለም አረንጓዴ ሸለቆ ይጎርፋሉ።</string>
    <string name="explore_gallery_item_ajora_twin_title">አጆራ መንትያ ፏፏቴዎች</string>
    <string name="explore_gallery_item_ajora_twin_desc">በሶዶ ሰሜናዊ ምዕራብ በሚገኝ ጥቅጥቅ ያለ ጫካ የተከበቡ ሁለት አስደናቂ ፏፏቴዎች።</string>
